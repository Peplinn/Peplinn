---
import type { InferEntrySchema } from 'astro:content'

import { FormattedDate, Icon } from '../user'

interface Props {
  // Hero images come from Sanity, where `src` is a CDN URL string - not the
  // `ImageMetadata` object the local-collection schema describes.
  data: Omit<InferEntrySchema<'writing'>, 'heroImage'> & {
    heroImage?: { src: string; alt?: string; width?: number; height?: number; color?: string }
    heroVideo?: { src: string }
  }
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  data: { title, description, draft, heroImage, heroVideo, publishDate, updatedDate, tags, language },
  remarkPluginFrontmatter
} = Astro.props

// The glow behind the hero is blurred 24px, so it needs almost no resolution.
// It used to reuse the full hero file, and on the snowplow post that full-size
// GIF under a blur filter became the LCP element at 17s on mobile. Sanity
// resizes it here; with `fm=webp` an animated GIF stays animated (all frames
// survive), so the glow still moves - at ~30KB instead of ~190KB.
const GLOW_WIDTH = 96
const glowSrc = heroImage?.src.startsWith('https://cdn.sanity.io/images/')
  ? `${heroImage.src.split('?')[0]}?w=${GLOW_WIDTH}&fm=webp&q=60`
  : heroImage?.src

const dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'short'
}
---

{draft ? <span class='text-red-500'>(Draft)</span> : null}

<div class='article-info max-lg:mx-auto'>
  <h1 class='mt-4 text-2xl font-medium sm:mb-2 sm:mt-6 sm:text-3xl'>
    {title}
  </h1>

  <div class='mt-3 italic'>
    <p class='text-muted-foreground'>{description}</p>
    <slot name='description' />
  </div>

  <div class='mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
    <div class='flex items-center gap-1'>
      <Icon name='calendar' class='size-5' />
      <FormattedDate date={publishDate} dateTimeOptions={dateTimeOptions} />
      {
        updatedDate && (
          <div class='flex items-center gap-1'>
            <span> / </span>
            <span>
              Update
              <FormattedDate date={updatedDate} dateTimeOptions={dateTimeOptions} />
            </span>
          </div>
        )
      }
    </div>
    {
      language && (
        <span class='flex items-center gap-1'>
          <Icon name='earth' class='size-5' />
          {language}
        </span>
      )
    }
  </div>
</div>

{
  (heroImage || heroVideo) && (
    <div class='hero-image relative mt-6'>
      {heroVideo ? (
        /* Same lazy clip as body videos (scripts/lazy-video.ts): `preload="none"`
           means the hero image paints first as the poster - and stays the LCP
           element - before a byte of video is fetched. The script then starts it,
           pauses it once scrolled away, and leaves it still with controls for
           readers who prefer reduced motion. */
        <video
          data-lazy-video
          src={heroVideo.src}
          poster={heroImage?.src}
          aria-label={heroImage?.alt || title}
          muted
          loop
          playsinline
          preload='none'
          class='cover-image relative z-10 h-48 w-full max-w-[65ch] rounded-2xl bg-muted object-cover'
        />
      ) : (
        /* Plain <img>, not astro:assets: these are remote Sanity URLs on an
           on-demand route, so each <Image> cost a serverless sharp invocation to
           redo work the Sanity CDN had already done - and converting format that
           way flattens an animated GIF to its first frame. */
        <img
          src={heroImage!.src}
          alt={heroImage!.alt || title}
          width={heroImage!.width}
          height={heroImage!.height}
          class='cover-image relative z-10 h-48 w-full max-w-[65ch] rounded-2xl object-cover'
          fetchpriority='high'
          loading='eager'
          decoding='async'
        />
      )}
      {/* The glow always comes from the still image - a second, blurred copy of
          the video would double what the hero streams. */}
      {glowSrc && (
        <img
          src={glowSrc}
          alt=''
          aria-hidden='true'
          id='blurImage'
          class='absolute end-0 top-4 z-0 mt-0 h-48 max-w-[65ch] rounded-3xl opacity-60 transition-opacity duration-300'
          loading='eager'
          fetchpriority='low'
          decoding='async'
        />
      )}
    </div>
  )
}
{/* Dividing line */}
<hr class='mt-4 w-1/2 border-t max-md:mx-auto sm:mt-6 sm:w-1/3' />
<script>
  const viewportHeight = window.innerHeight
  const threshold1 = viewportHeight / 9
  const threshold2 = (viewportHeight * 2) / 9
  const threshold3 = (viewportHeight * 3) / 9
  const image = document.getElementById('blurImage') as HTMLImageElement

  if (image) {
    window.addEventListener('scroll', () => {
      const scrollDistance = window.scrollY
      // console.log(scrollDistance, threshold1, threshold2, threshold3)

      if (scrollDistance >= threshold3) {
        image.style.opacity = '0.15'
      } else if (scrollDistance >= threshold2) {
        image.style.opacity = '0.3'
      } else if (scrollDistance >= threshold1) {
        image.style.opacity = '0.45'
      }
    })
  }
</script>

<style>
  #blurImage {
    --un-blur: blur(24px);
    filter: var(--un-blur);
  }
</style>
