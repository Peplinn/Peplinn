---
import { Icons } from '../../libs/icons'
---

{/* Use inline mode to quick load color, which can avoid splash */}
<script is:inline>
  function simpleSetTheme() {
    let theme = localStorage.getItem('theme')
    // If undefined or 'system', get from system
    if (!theme || theme === 'system') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    document.documentElement.classList.toggle('dark', theme === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#0B0B10' : '#FCFCFD')
  }
  simpleSetTheme()
  document.addEventListener('astro:page-load', () => simpleSetTheme())
</script>

{/* The toast's icon is rendered here, on the server. Importing `Icons` into the
    client script below shipped the entire icon library (~49KB) to every page
    just to draw this one glyph. */}
<template id='toast-info-icon'>
  <svg width='22' height='22' viewBox='0 0 24 24' fill='currentColor' set:html={Icons.info} />
</template>

<script>
  import { listenThemeChange } from '../../utils'

  // Listen for theme change event
  listenThemeChange()
  // Listen for toast event
  document.addEventListener('toast', (e) => {
    const { message } = (e as CustomEvent).detail
    const toast = document.createElement('div')
    toast.className =
      'animate fixed bottom-8 z-20 px-4 py-2 bg-muted text-foreground rounded-lg border shadow-lg flex items-center gap-2'
    const icon = document.getElementById('toast-info-icon') as HTMLTemplateElement | null
    if (icon) toast.append(icon.content.cloneNode(true))
    const text = document.createElement('span')
    text.textContent = message
    toast.append(text)
    document.body.appendChild(toast)
    setTimeout(() => {
      toast.remove()
    }, 3000)
  })
</script>
