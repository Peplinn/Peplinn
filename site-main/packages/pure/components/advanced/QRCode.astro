---
import config from 'virtual:config'

interface Props {
  content?: string
  class?: string
  /** Id of the element whose first click loads and draws the code. */
  trigger?: string
  [key: string]: unknown
}

const { content, class: className, trigger = 'get-qrcode', ...props } = Astro.props
// Pinned: an unversioned CDN URL is only cacheable for a week and can change under us.
const src = `${config.npmCDN}/qrcodejs@1.0.0/qrcode.min.js`
---

<div id='qrcode-container' class={className} {...props}></div>

{/* The library used to load as a parser-blocking third-party script on every
    article, for a panel almost nobody opens. It now loads on the first click. */}
<script is:inline define:vars={{ content, src, trigger }}>
  const button = document.getElementById(trigger)
  const container = document.getElementById('qrcode-container')
  button?.addEventListener(
    'click',
    () => {
      const script = document.createElement('script')
      script.src = src
      script.onload = () => new QRCode(container, content ?? window.location.href)
      document.head.append(script)
    },
    { once: true }
  )
</script>
