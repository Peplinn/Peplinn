---
import { Button, FormattedDate, Icon } from 'astro-pure/user'

import type { PostKind, WritingCollectionPost } from '../../lib/sanity'
import { KINDS } from '../../lib/sanity-helpers'

/**
 * One tile in the writing grid.
 *
 * Hierarchy is carried by **size** - an article occupies two cells, everything
 * else one - with a small mark and word in the meta line to make the kind
 * explicit. Earlier attempts tied identity to whether a post had a hero image,
 * which broke as soon as notes had images too: it made the mark an exception
 * rather than a system. Now every card shows its image and every card names its
 * kind.
 *
 * Separate from astro-pure's `PostPreview` rather than a rewrite of it, because
 * that component is still used unmodified by the tag pages.
 */
interface Props {
  post: WritingCollectionPost
  /** The first row is above the fold; the rest shouldn't block on their image. */
  eager?: boolean
}

/** Articles are wider, thicker-edged, and carry the site's only resting shadow. */
const TIERS = {
  article: 'sm:col-span-2 border-2 shadow-sm bg-background hover:bg-muted',
  guide: 'border bg-background hover:bg-muted',
  note: 'border bg-background hover:bg-muted'
} as const satisfies Record<PostKind, string>

/** Enough to signal the subject, few enough not to wrap a one-cell card. */
const MAX_TAGS = 3

const { post, eager = false } = Astro.props
const { data } = post
const kind = KINDS[data.kind]
const hero = data.heroImage
---

<li
  class:list={[
    'writing-card group/card flex flex-col overflow-hidden rounded-2xl transition-all ease-in-out',
    TIERS[data.kind]
  ]}
  style={hero?.color &&
    `--card-highlight:color-mix(in srgb,${hero.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)))`}
>
  <a class='flex flex-col' href={`/writing/${post.slug}`} data-astro-prefetch>
    {
      /* Fixed height rather than an aspect ratio, so panels line up across a row
        even though an article's card is twice as wide. */
    }
    {
      hero ? (
        <img
          src={hero.src}
          alt={hero.alt || data.title}
          width={hero.width}
          height={hero.height}
          class='h-40 w-full border-b object-cover transition-opacity duration-300 group-hover/card:opacity-90 sm:h-44'
          loading={eager ? 'eager' : 'lazy'}
          decoding='async'
        />
      ) : (
        <div
          class='flex h-40 w-full items-center justify-center border-b bg-muted/60 sm:h-44'
          aria-hidden='true'
        >
          <Icon name={kind.icon} class='size-12 text-muted-foreground/45' />
        </div>
      )
    }

    <div class='flex flex-col gap-y-1.5 px-4 pb-2 pt-3.5'>
      <span class='card-title font-display font-medium transition-colors'>
        {data.draft && <span class='text-red-500'>(Draft) </span>}
        {data.title}
      </span>

      {
        data.description && (
          <p class='line-clamp-3 text-sm leading-snug text-muted-foreground'>{data.description}</p>
        )
      }

      <div class='flex items-center gap-x-2 pt-1 text-xs text-muted-foreground'>
        <Icon name={kind.icon} class='size-3.5 shrink-0' aria-hidden='true' />
        <span>{kind.label}</span>
        <span aria-hidden='true'>·</span>
        <FormattedDate date={data.publishDate} />
      </div>
    </div>
  </a>

  {
    /* Outside the card link: a link inside a link is invalid, and these go
      somewhere else entirely. */
  }
  {
    !!data.tags.length && (
      <ul class='tag-list mt-auto flex flex-wrap gap-1.5 px-4 pb-3.5 pt-1'>
        {data.tags.slice(0, MAX_TAGS).map((tag: string) => (
          <li>
            <Button
              title={tag}
              href={`/tags/${tag}`}
              variant='pill'
              class='!px-2 !py-0.5 !text-xs'
            />
          </li>
        ))}
      </ul>
    )
  }
</li>

<style>
  /* An article's card borrows its own hero colour for the title on hover. */
  .writing-card:hover .card-title {
    color: var(--card-highlight, hsl(var(--primary) / var(--un-text-opacity, 1)));
  }
</style>
