---
import { FormattedDate, Icon } from 'astro-pure/user'

import type { PostKind, WritingCollectionPost } from '../../lib/sanity'
import { KINDS } from '../../lib/sanity-helpers'

/**
 * One tile in the writing grid.
 *
 * Every card keeps the same shape so the grid stays regular; what varies is the
 * panel at the top. A post with a hero image shows it, and everything else shows
 * its type mark large on a tinted panel - which is what keeps an image-less card
 * from reading as broken next to an image one, and gives the marks a job beyond
 * decoration.
 *
 * Separate from astro-pure's `PostPreview` rather than a rewrite of it, because
 * that component is still used unmodified by /archives and the tag pages.
 */
interface Props {
  post: WritingCollectionPost
  /** The first row is above the fold; the rest shouldn't block on their image. */
  eager?: boolean
}

/**
 * The tier ladder, as chrome rather than content: an article sits lifted off the
 * page, a guide is a plain outline, a note recedes into a filled panel. Articles
 * carry the only resting shadow anywhere on the site, which is what makes them
 * read as raised rather than merely thicker.
 */
const TIERS = {
  article: 'border-2 shadow-sm bg-background hover:bg-muted',
  guide: 'border bg-background hover:bg-muted',
  note: 'border bg-muted/40 hover:bg-muted'
} as const satisfies Record<PostKind, string>

const { post, eager = false } = Astro.props
const { data } = post
const kind = KINDS[data.kind]

// Imagery is part of the tier, not a property of the document. A note that
// happens to carry a hero image would otherwise render as an article.
const hero = data.kind === 'article' ? data.heroImage : undefined
---

<li
  class:list={[
    'writing-card group/card overflow-hidden rounded-2xl transition-all ease-in-out',
    TIERS[data.kind]
  ]}
  style={hero?.color &&
    `--card-highlight:color-mix(in srgb,${hero.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)))`}
>
  <a class='flex h-full flex-col' href={`/writing/${post.slug}`} data-astro-prefetch>
    {
      hero ? (
        <img
          src={hero.src}
          alt={hero.alt || data.title}
          width={hero.width}
          height={hero.height}
          class='aspect-[3/2] w-full border-b object-cover transition-opacity duration-300 group-hover/card:opacity-90'
          loading={eager ? 'eager' : 'lazy'}
          decoding='async'
        />
      ) : (
        <div
          class='flex aspect-[3/2] w-full items-center justify-center border-b bg-muted/60'
          aria-hidden='true'
        >
          <Icon
            name={kind.icon}
            class='size-12 text-muted-foreground/45 transition-colors duration-300 group-hover/card:text-muted-foreground/70'
          />
        </div>
      )
    }

    <div class='flex flex-grow flex-col gap-y-1.5 px-4 py-3.5'>
      <span class='card-title font-display font-medium transition-colors'>
        {data.draft && <span class='text-red-500'>(Draft) </span>}
        {data.title}
      </span>

      {
        data.description && (
          <p class='line-clamp-3 text-sm leading-snug text-muted-foreground'>{data.description}</p>
        )
      }

      {/* Pushed to the bottom so the meta line sits flush across a ragged row. */}
      <div class='mt-auto flex items-center gap-x-2 pt-2 text-xs text-muted-foreground'>
        <span class='sr-only'>{kind.label}:</span>
        <FormattedDate date={data.publishDate} />
        {data.kind !== 'note' && <span aria-hidden='true'>·</span>}
        {data.kind !== 'note' && <span>{data.minutesRead}</span>}
      </div>
    </div>
  </a>
</li>

<style>
  /* An article's card borrows its own hero colour for the title on hover. */
  .writing-card:hover .card-title {
    color: var(--card-highlight, hsl(var(--primary) / var(--un-text-opacity, 1)));
  }
</style>
