---
import { Icon } from 'astro-pure/user'

import { POST_KINDS, type PostKind } from '../../lib/sanity'
import { KINDS } from '../../lib/sanity-helpers'

/**
 * A dropdown checklist for narrowing /writing to one or more kinds of post.
 *
 * Built as a real `<form method="get">` inside native `<details>` rather than a
 * client-side toggle: checking boxes and hitting Apply is a normal GET
 * navigation to `/writing?type=article&type=note`, so it works with no JS,
 * survives a page reload, and is a link you can copy and share. The script
 * below only adds outside-click / Escape to close the panel - a convenience,
 * not the mechanism.
 */
interface Props {
  selected: PostKind[]
  counts: Record<PostKind, number>
}

const { selected, counts } = Astro.props
const activeCount = selected.length
---

<details class='type-filter group relative inline-block'>
  <summary
    class='inline-flex cursor-pointer list-none select-none items-center gap-x-1.5 rounded-lg border bg-muted px-3 py-1.5 text-sm text-muted-foreground transition-all hover:bg-primary-foreground [&::-webkit-details-marker]:hidden'
  >
    <span>Type</span>
    {
      activeCount > 0 && (
        <span class='rounded-full bg-primary/15 px-1.5 py-0.5 text-xs font-medium leading-none text-primary'>
          {activeCount}
        </span>
      )
    }
    <svg
      xmlns='http://www.w3.org/2000/svg'
      width='14'
      height='14'
      viewBox='0 0 24 24'
      fill='none'
      stroke-width='2.5'
      stroke-linecap='round'
      stroke-linejoin='round'
      class='chevron shrink-0 stroke-muted-foreground transition-transform duration-200'
    >
      <polyline points='6 9 12 15 18 9'></polyline>
    </svg>
  </summary>

  <form
    method='get'
    action='/writing'
    class='absolute start-0 top-[calc(100%+0.5rem)] z-20 w-60 rounded-xl border bg-background p-3 shadow-sm'
  >
    <ul class='flex flex-col gap-y-0.5'>
      {
        POST_KINDS.map((kind) => (
          <li>
            <label class='flex cursor-pointer items-center gap-x-2 rounded-lg px-2 py-1.5 text-sm transition-colors hover:bg-muted'>
              <input type='checkbox' name='type' value={kind} checked={selected.includes(kind)} />
              <Icon name={KINDS[kind].icon} class='size-4 shrink-0 text-muted-foreground' />
              <span class='flex-1'>{KINDS[kind].label}</span>
              <span class='text-xs text-muted-foreground'>{counts[kind]}</span>
            </label>
          </li>
        ))
      }
    </ul>

    <div class='mt-2 flex items-center justify-between border-t pt-2'>
      <a href='/writing' class='text-xs text-muted-foreground transition-colors hover:text-primary'>
        Clear
      </a>
      <button
        type='submit'
        class='rounded-lg border bg-background px-3 py-1.5 text-xs font-medium transition-colors hover:bg-muted'
      >
        Apply
      </button>
    </div>
  </form>
</details>

<style>
  /* `<details>` has no outside-click/Escape close, so the panel would otherwise
     only ever close via a second click on the trigger. */
  .type-filter[open] .chevron {
    transform: rotate(180deg);
  }

  input[type='checkbox'] {
    accent-color: hsl(var(--primary));
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.type-filter').forEach((el) => {
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false
    })
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') el.open = false
    })
  })
</script>
