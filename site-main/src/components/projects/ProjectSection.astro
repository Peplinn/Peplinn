---
import type { iconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Project {
  image?: {
    src: string
    alt: string
    width: number
    height: number
  }
  name: string
  description: string
  /**
   * Internal destination. When set the whole card becomes a link, and `links` is
   * ignored - an anchor cannot legally contain other anchors.
   */
  href?: string
  /**
   * Opens the full-size image in the page's lightbox instead of navigating. The
   * card gets a stretched button over it, so the outbound `links` below still
   * work: they sit above the button rather than inside it.
   */
  lightbox?: {
    src: string
    alt: string
    title: string
    description: string
    github?: string
  }
  /** Small line under the description, e.g. a count of grouped items. */
  meta?: string
  links?: {
    type: string
    href: string
  }[]
}

interface Props {
  class?: string
  projects: Project[]
}

const { class: className, projects, ...props } = Astro.props

const projectIconSet: Record<string, iconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  release: 'package'
}
---

<div class={cn('grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 sm:gap-y-4', className)} {...props}>
  {
    projects.map((project) => {
      const Tag = project.href ? 'a' : 'div'
      return (
        <Tag
          href={project.href}
          class={cn(
            'group/card relative flex flex-row gap-x-4 overflow-hidden rounded-2xl border bg-background px-4 py-3.5 transition-colors ease-in-out hover:bg-muted',
            (project.href || project.lightbox) && 'no-underline'
          )}
        >
          {/* `cover`, so the preview fills its box. `contain` fits the whole chart
              in but letterboxes anything that is not 4:3, which reads as dead
              space around the image. */}
          {project.image && (
            <img
              class='aspect-[4/3] w-24 flex-shrink-0 rounded-lg border bg-muted object-cover transition-opacity duration-300 group-hover/card:opacity-90 sm:w-28'
              src={project.image.src}
              alt={project.image.alt}
              width={project.image.width}
              height={project.image.height}
              loading='lazy'
              decoding='async'
            />
          )}

          <div class='flex min-w-0 flex-1 flex-col gap-y-1.5'>
            <div class='font-display font-medium text-foreground'>{project.name}</div>

            {/* Deliberately unclamped: the description is what tells a reader what
                the project is, so the card grows rather than truncating it. */}
            <p class='text-sm leading-snug text-muted-foreground'>{project.description}</p>

            {project.meta && (
              <div class='flex items-center gap-x-1 pt-0.5 text-xs text-muted-foreground transition-colors group-hover/card:text-foreground'>
                <span>{project.meta}</span>
                <span
                  aria-hidden='true'
                  class='transition-transform group-hover/card:translate-x-0.5'
                >
                  &rarr;
                </span>
              </div>
            )}

            {(project.lightbox || (!project.href && project.links?.length)) && (
              <div class='mt-auto flex flex-row items-center gap-x-3 pt-1.5'>
                {/* The affordance the card used to lack. Always visible, since a
                  hover-only cue tells a touch reader nothing. */}
                {project.lightbox && (
                  <span class='pointer-events-none z-20 flex items-center gap-x-1 text-xs font-medium text-muted-foreground transition-colors group-hover/card:text-primary'>
                    <Icon class='size-3.5' name='search' />
                    View
                  </span>
                )}

                {!project.href && project.links && project.links.length > 0 && (
                  <div class='relative z-20 flex flex-row items-center gap-x-2'>
                    {project.links.map((link) => {
                      const icon = projectIconSet[link.type]
                      return (
                        <a
                          href={link.href}
                          class='rounded-full bg-muted p-1 text-muted-foreground transition-colors hover:text-foreground'
                          aria-label={link.type}
                          target='_blank'
                        >
                          <Icon class='size-4' name={icon} />
                        </a>
                      )
                    })}
                  </div>
                )}
              </div>
            )}
          </div>

          {/* Stretched hit area. Sits under the links above it (z-20) so those stay
              clickable, and carries the accessible name for the whole card. */}
          {project.lightbox && (
            <button
              type='button'
              class='absolute inset-0 z-10 cursor-pointer'
              aria-label={`View ${project.lightbox.title}`}
              data-viz-src={project.lightbox.src}
              data-viz-alt={project.lightbox.alt}
              data-viz-title={project.lightbox.title}
              data-viz-description={project.lightbox.description}
              data-viz-github={project.lightbox.github}
            />
          )}
        </Tag>
      )
    })
  }
</div>
