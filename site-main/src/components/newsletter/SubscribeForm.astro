---
/**
 * Posts to `/api/subscribe` rather than to Resend, because the API key has to
 * stay on the server.
 *
 * Works as a plain form with no JavaScript - it submits, the route redirects
 * back with `?subscribed=`, and the message below renders server-side. The
 * script upgrades that to an inline response without a page reload.
 */
interface Props {
  /** Set from the `?subscribed=` param after a no-JS submission. */
  status?: 'yes' | 'no' | null
  /**
   * `subtle` drops the card treatment so the form doesn't compete with the page
   * it sits on - used at the top of /newsletter, above the archive.
   */
  variant?: 'card' | 'subtle'
}

const { status = null, variant = 'card' } = Astro.props
const subtle = variant === 'subtle'
---

<section
  class:list={[
    'subscribe not-prose',
    subtle ? 'border-b pb-6' : 'rounded-xl border bg-muted/50 px-4 py-3'
  ]}
>
  <h2 class:list={['font-display font-medium', subtle ? 'mb-2 text-lg' : 'mb-3 text-xl']}>
    My email list
  </h2>
  <form
    class='flex flex-col gap-2 sm:flex-row sm:items-center'
    method='post'
    action='/api/subscribe'
  >
    <label class='sr-only' for='subscribe-email'>Email address</label>
    <input
      id='subscribe-email'
      type='email'
      name='email'
      required
      autocomplete='email'
      placeholder='you@email.com'
      class:list={[
        'w-full rounded-lg border bg-background px-3 py-1.5 text-sm outline-none transition-colors focus:border-foreground',
        subtle && 'sm:max-w-xs'
      ]}
    />
    <button
      type='submit'
      class:list={[
        'shrink-0 rounded-lg border px-4 py-1.5 text-sm font-medium transition-opacity disabled:opacity-60',
        subtle
          ? 'border-border bg-transparent text-foreground hover:bg-muted'
          : 'border-foreground bg-foreground text-background hover:opacity-90'
      ]}
    >
      Subscribe
    </button>
  </form>

  <p
    class='subscribe-message mt-2 text-xs text-muted-foreground empty:mt-0'
    role='status'
    aria-live='polite'
    data-state={status ?? undefined}
  >
    {status === 'yes' && 'Thanks! Check your inbox for a confirmation link.'}
    {status === 'no' && 'Something went wrong. Please try again.'}
  </p>
</section>

<style>
  .subscribe-message[data-state='yes'] {
    color: hsl(var(--primary));
  }
  .subscribe-message[data-state='no'] {
    color: hsl(var(--destructive));
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.subscribe form').forEach((form) => {
    const section = form.closest('.subscribe')!
    const message = section.querySelector<HTMLParagraphElement>('.subscribe-message')!
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      const email = new FormData(form).get('email')
      button.disabled = true
      message.dataset.state = ''
      message.textContent = 'Subscribing...'

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        })
        const result = (await response.json()) as { ok: boolean; message?: string }

        message.dataset.state = result.ok ? 'yes' : 'no'
        message.textContent = result.ok
          ? 'Thanks! Check your inbox for a confirmation link.'
          : (result.message ?? 'Something went wrong. Please try again.')

        if (result.ok) form.reset()
      } catch {
        message.dataset.state = 'no'
        message.textContent = 'Could not reach the server. Please try again.'
      } finally {
        button.disabled = false
      }
    })
  })
</script>
