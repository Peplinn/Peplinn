---
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Bookshelf from '@/components/about/Bookshelf.astro'
import config from '@/site-config'

import { renderMarkdown } from '../../lib/markdown'
import { getAboutPage, getBooks, getNowSection, type Book } from '../../lib/sanity'
import { noStore } from '../../lib/ssr'

export const prerender = false

noStore(Astro.response.headers)

const footerConf = config.footer
const SOCIAL_LABELS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  email: 'Email'
}

const social = footerConf.social || {}

const [about, now, books] = await Promise.all([getAboutPage(), getNowSection(), getBooks()])

// Shown until the About document exists in Sanity, so deploying this never leaves
// /about blank. Safe to delete once the content is in the studio.
const FALLBACK_BODY = `I am a Master's student in Big Data Analytics based in Ontario, Canada, with a background in backend development.

I'm interested in using data to solve people's day-to-day problems. Recently, my academic and personal projects have focused on climate and urbanization where I apply statistical analysis, data modelling, and visualization techniques to reveal actionable insights, using Python, SQL, and Tableau.

When I'm not working, I spend time learning, writing, making art, and gaming.

*Stay curious.*`

const bodyHtml = await renderMarkdown(about?.body || FALLBACK_BODY)
const nowHtml = now?.body ? await renderMarkdown(now.body) : ''

const bookshelfHeading = about?.bookshelfHeading ?? 'Bookshelf'
const showBookshelf = Boolean(bookshelfHeading) && books.length > 0

const BOOK_GROUPS: { status: Book['status']; label: string }[] = [
  { status: 'reading', label: 'Currently reading' },
  { status: 'finished', label: 'Finished' },
  { status: 'want', label: 'Want to read' }
]
const groupedBooks = BOOK_GROUPS.map((group) => ({
  ...group,
  items: books.filter((b) => b.status === group.status)
})).filter((group) => group.items.length > 0)

const nowUpdated = now?.updatedAt
  ? now.updatedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null
---

{
  /* No table of contents here - the page is short and its two sections are visible
    at a glance. The heading ids stay so /about#bookshelf and /about#now still work. */
}
<PageLayout title={about?.heading ?? 'About'}>
  <div set:html={bodyHtml} />

  {/* Social Icons */}
  <div class='mt-6 flex items-center gap-x-4'>
    {
      Object.entries(social)
        .filter(([platform]) => ['github', 'linkedin', 'email'].includes(platform))
        .map(([platform, url]) => (
          <a
            class='inline-block text-muted-foreground transition-all hover:text-primary'
            href={url as string}
            aria-label={SOCIAL_LABELS[platform] ?? platform}
          >
            <Icon name={platform as keyof typeof social} />
          </a>
        ))
    }
  </div>

  

  {
    nowHtml && (
      <>
        <h2 id='now'>{now!.heading}</h2>
        {nowUpdated && (
          <p class='not-prose -mt-2 mb-4 text-sm text-muted-foreground'>
            Last updated {nowUpdated}
          </p>
        )}
        <div set:html={nowHtml} />
      </>
    )
  }

  {
    showBookshelf && (
      <>
        <h2 id='bookshelf'>{bookshelfHeading}</h2>
        {about?.bookshelfIntro && <p>{about.bookshelfIntro}</p>}

        <Bookshelf groups={groupedBooks} />
      </>
    )
  }
</PageLayout>
