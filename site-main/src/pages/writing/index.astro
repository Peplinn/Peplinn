---
import WritingList from '@/components/writing/WritingList.astro'
import config from '@/site-config'

import { getSanityPosts } from '../../lib/sanity'
import { countByKind, parseSelectedKinds } from '../../lib/sanity-helpers'
import { CACHE, cacheable, paginate } from '../../lib/ssr'

export const prerender = false

cacheable(Astro.response.headers, CACHE.listing)

const allPosts = await getSanityPosts()

// Tags and counts come from the unfiltered set: the sidebar is the site's whole
// tag vocabulary, and a facet count that shrank to match your own filter would
// tell you nothing.
const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))] as string[]
const kindCounts = countByKind(allPosts)

// No selection means no filter rather than no results - an empty checklist
// showing an empty page would read as a bug.
const selectedKinds = parseSelectedKinds(Astro.url.searchParams)
const collections = selectedKinds.length
  ? allPosts.filter((post) => selectedKinds.includes(post.data.kind))
  : allPosts

const page = paginate(collections, {
  baseUrl: '/writing',
  pageSegment: 'page',
  pageSize: config.content.blogPageSize
})!
---

<WritingList
  {page}
  {uniqueTags}
  {selectedKinds}
  {kindCounts}
  collectionsCount={collections.length}
/>
