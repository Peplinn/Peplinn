---
import { Button, FormattedDate } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

import { renderMarkdown } from '../../lib/markdown'
import { getNewsletterIssue } from '../../lib/sanity'
import { CACHE, cacheable } from '../../lib/ssr'

export const prerender = false

cacheable(Astro.response.headers, CACHE.post)

const { id } = Astro.params

const issue = await getNewsletterIssue(id!)
if (!issue) return Astro.rewrite('/404')

const html = await renderMarkdown(issue.content)

const meta = {
  description: issue.description || 'A newsletter issue.',
  title: issue.title,
  // Same reasoning as /newsletter: reachable by direct link, not yet launched.
  noindex: true
}
---

<PageLayout {meta}>
  <Button title='Newsletter' href='/newsletter' variant='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <FormattedDate class='text-xs text-muted-foreground' date={issue.publishDate} />
      <h1 class='mb-3 mt-1 text-3xl font-medium'>{issue.title}</h1>
    </div>

    <article class='prose prose-pure dark:prose-invert max-w-none' set:html={html} />
  </main>
</PageLayout>
