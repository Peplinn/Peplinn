---
import { Button, FormattedDate } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

import { getNewsletterIssues } from '../../lib/sanity'
import { CACHE, cacheable } from '../../lib/ssr'

export const prerender = false

cacheable(Astro.response.headers, CACHE.listing)

const issues = await getNewsletterIssues()

const meta = {
  description: 'Issues of the newsletter.',
  title: 'Newsletter',
  // Reachable by direct URL only - not yet linked from the header or /writing,
  // and not ready to be found on its own. Drop this once it's launched.
  noindex: true
}
---

<PageLayout {meta}>
  <Button title='Home' href='/' variant='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-2 text-3xl font-medium'>Newsletter</h1>
      <p class='text-muted-foreground'>{meta.description}</p>
    </div>

    <section id='content' class='animate mt-6' aria-label='Newsletter issues'>
      {
        issues.length === 0 ? (
          <p class='text-muted-foreground'>Nothing here yet.</p>
        ) : (
          <ul class='flex flex-col gap-y-1'>
            {issues.map((issue) => (
              <li>
                <a
                  class='group flex items-center gap-x-3 py-1.5 transition-colors hover:text-primary'
                  href={`/newsletter/${issue.slug}`}
                  data-astro-prefetch
                >
                  <span class='truncate font-display'>{issue.title}</span>
                  <span class='h-px min-w-4 flex-1 bg-border' aria-hidden='true' />
                  <FormattedDate
                    class='shrink-0 text-xs text-muted-foreground'
                    date={issue.publishDate}
                  />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</PageLayout>
