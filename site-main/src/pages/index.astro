---
import { Image } from 'astro:assets'

import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import WritingRow from '@/components/writing/WritingRow.astro'
import avatar from '@/assets/avatar.png'
import portrait from '@/assets/portrait.jpg'
import config from '@/site-config'

import { buildProjectCards } from '../lib/projects'
import { getSanityPosts, getSanityProjects } from '../lib/sanity'
import { CACHE, cacheable } from '../lib/ssr'

export const prerender = false

cacheable(Astro.response.headers, CACHE.listing)

const SOCIAL_LABELS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  email: 'Email'
}

const social = config.footer.social || {}

const projects = await getSanityProjects()

// Same grouping as /projects: one Visualizations card, then featured programs.
const projectCards = buildProjectCards(
  projects.filter((p) => p.data.type === 'visualization' || p.data.featured)
).slice(0, 4)

const RECENT_POSTS = 5

// `getSanityPosts` already sorts newest first.
const recentPosts = (await getSanityPosts()).slice(0, RECENT_POSTS)
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col items-start md:w-3/4 lg:w-2/3 mx-auto'>
    <!-- Header Section with Avatar and Greeting -->
    <section class='animate mb-4 flex flex-row items-center gap-x-4 w-full' id='content-header'>
      <Image
        src={portrait}
        alt='profile'
        class='h-24 w-24 flex-shrink-0 rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col gap-y-1'>
        <h1 class='text-2xl font-medium'>Hey! I'm Ebube</h1>
        <p class='text-base text-foreground/70'>Pronounced /ae-boo-bae/</p>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 w-full'>
      <!-- About Section (no heading) -->
      <div class='flex flex-col gap-y-4'>
        <p class='text-base text-foreground/80'>
          I use data to solve problems. My work spans statistical modelling, machine learning, and
          software development, and I am drawn to projects rooted in real-world systems.
        </p>
        {/* Social links, in place of the old "More about me" button */}
        <div class='flex items-center gap-x-4'>
          {
            Object.entries(social)
              .filter(([platform]) => ['github', 'linkedin', 'email'].includes(platform))
              .map(([platform, url]) => (
                <a
                  class='inline-block text-muted-foreground transition-all hover:text-primary'
                  href={url as string}
                  aria-label={SOCIAL_LABELS[platform] ?? platform}
                >
                  <Icon name={platform as keyof typeof social} />
                </a>
              ))
          }
        </div>
      </div>

      <Section title='Recent Projects' class='!flex-col !gap-y-5'>
        <ProjectSection projects={projectCards} />
        <Button title='All projects' class='w-fit' href='/projects' variant='ahead' />
      </Section>

      {
        recentPosts.length > 0 && (
          <Section title='Recent Posts' class='!flex-col !gap-y-3'>
            {/* Single lines here, marked by kind - the cards live on /writing. */}
            <ul class='flex w-full flex-col'>
              {recentPosts.map((p) => (
                <WritingRow post={p} />
              ))}
            </ul>
            <Button title='All posts' class='w-fit' href='/writing' variant='ahead' />
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>
