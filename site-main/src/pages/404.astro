---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

// On-demand rather than prerendered so SSR routes can `Astro.rewrite('/404')`
// into it and answer a real 404 status. Rewriting into a prerendered route is a
// build-time error in Astro.
export const prerender = false

const meta = {
  description: 'Not found',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>N/A</h1>
    <p class='mt-3 text-muted-foreground'>No data here!</p>
    <p class='text-lg'>Sorry, I couldn't find that page.</p>
    <Button title='Home' href='/' variant='ahead' class='mt-5' />
  </div>
</PageLayout>
