---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import SiteSearch from '@/components/search/SiteSearch.astro'

const meta = {
  description: 'Search all posts.',
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/writing' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      <SiteSearch />
    </div>
  </main>
</PageLayout>
