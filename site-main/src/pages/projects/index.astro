---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

import { buildProjectCards } from '../../lib/projects'
import { getSanityProjects } from '../../lib/sanity'
import { noStore } from '../../lib/ssr'

export const prerender = false

noStore(Astro.response.headers)

const projects = await getSanityProjects()

// Visualizations collapse into a single card that opens /projects/visualizations;
// every other project keeps a card of its own.
const cards = buildProjectCards(projects)
---

<PageLayout title='Projects'>
  <ProjectSection projects={cards} />

  <p>
    If you would like to collaborate on a project, support this website, or just say hello, you can
    contact me below.
  </p>
  <Button title='Say hello' class='w-fit' href='mailto:ebube@ebubeoluoma.com'>
    <Icon class='size-5' name='email' slot='before' />
  </Button>
  <Button title='Cheers!' class='w-fit' href='https://buymeacoffee.com/peplinn'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>
</PageLayout>
